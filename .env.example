# Copy to .env and fill in what you need. Everything is optional in local
# development — features degrade gracefully with a clear message when their
# variable is unset.

# ----------------------------------------------------------------- runtime
# Every variable below is declared, typed and validated once at boot in
# server/env.ts: a value that does not parse (a port that is not a number, a
# boolean that is not true/false/1/0) stops the server with a message naming
# it, and a variable set to an empty value counts as unset.
# proWIN boot guard runs first: ANTHROPIC_API_KEY, OPENAI_API_KEY,
# GEMINI_API_KEY, ARK_API_KEY, POSTHOG_KEY and VITE_POSTHOG_KEY must be unset
# or empty. Any nonempty value (including whitespace) stops the server.
# The error lists variable names only. See docs/prowin/boot-guard.md.
#POSTHOG_KEY=
#VITE_POSTHOG_KEY=
# development (default) | test | production. Production requires
# BETTER_AUTH_SECRET and BETTER_AUTH_URL and serves the built client.
#NODE_ENV=development
#PORT=4400

# ---------------------------------------------------------------- database
# Unset = embedded Postgres (PGlite) persisted to ./data/pg — fine for local
# dev and single-instance self-hosting with a persistent volume. Set to a
# real Postgres in any serious deployment (same code path).
#DATABASE_URL=postgres://user:pass@host:5432/doop

# -------------------------------------------------------------------- auth
# Required in production (the server refuses to boot without it there).
# Long random string; sessions and OAuth tokens are signed with it.
#BETTER_AUTH_SECRET=
# Public origin of the deployment, e.g. https://doop.example.com — OAuth
# discovery/redirect URLs and absolute asset URLs are built on it.
#BETTER_AUTH_URL=
# Extra allowed origins for auth requests (comma-separated). Defaults to the
# localhost dev origins.
#TRUSTED_ORIGINS=
# Optional comma-separated domain allowlist for new accounts. Unset means
# anyone can sign up. Existing users can always continue to sign in.
#SIGNUP_EMAIL_DOMAINS=jointhetroops.com
# Instance admins (comma-separated emails). These accounts get the admin role
# — at signup, and at boot for accounts that already exist — which unlocks
# /admin: every canvas and account on the instance, plus read-only "view as".
# Removing an email here does not demote anyone; that is an explicit action.
# REQUIRES SMTP in production: an address only identifies someone once they
# have verified it, and without a mailer signup is open, so a stranger could
# claim your address and the role with it. Production without SMTP promotes
# nobody and says so at boot; local development promotes without verifying.
#ADMIN_EMAILS=you@example.com

# Optional "Sign in with Google", alongside email/password.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) with BETTER_AUTH_URL + /api/auth/callback/google as
# an authorised redirect URI, e.g. https://doop.example.com/api/auth/callback/google
# (http://localhost:4300/api/auth/callback/google in dev). Both must be set
# together; the server refuses to boot with only one. A Google sign-in whose
# email is verified and matches an existing email/password account links to it.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Optional "Sign in with Apple", in two independent halves. The web button:
# register a Services ID at https://developer.apple.com/account/resources
# (Identifiers, Services IDs) with Sign in with Apple enabled, your domain
# verified and BETTER_AUTH_URL + /api/auth/callback/apple as a return URL;
# APPLE_CLIENT_ID is that Services ID and APPLE_CLIENT_SECRET the client
# secret JWT signed with your Sign in with Apple key (expires within 6
# months; regenerate it). Both must be set together. The iOS app: set
# APPLE_APP_BUNDLE_IDENTIFIER to the app's bundle id (design.doop.ios for
# Doop's own build) and the server accepts the identity tokens the native
# Sign in with Apple sheet issues for it. Either half works without the
# other. "Hide My Email" addresses end in @privaterelay.appleid.com, which
# SIGNUP_EMAIL_DOMAINS would reject unless listed.
#APPLE_CLIENT_ID=
#APPLE_CLIENT_SECRET=
#APPLE_APP_BUNDLE_IDENTIFIER=
# Where the server fetches Apple's signing keys to verify native identity
# tokens. Only the test suite points this elsewhere.
#APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# ------------------------------------------------------------------- email
# SMTP for verification, password-reset and comment-notification emails (works
# with any provider: Resend, Postmark, SES, a local relay). With SMTP_HOST set,
# new signups must verify their email before signing in, and collaborators are
# emailed about new comments and replies (each person can switch that off under
# Settings → Your account). Unset = signup stays open and every auth email is
# printed to the server log instead — links included, so the flows still work
# in development; comment emails are simply not sent.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
# true forces implicit TLS (also implied by port 465)
#SMTP_SECURE=
# NOTE ON PORTS: many hosts (Railway, Fly, most PaaS) block outbound 25/465/587
# to deter spam, and a blocked port shows up as a ~3 minute hang on any request
# that sends mail, not as an error. Resend also listens on 2465 and 2587 for
# exactly this reason — if signup or password reset hangs, try SMTP_PORT=2587.

# Set to false to let people sign in before verifying their email — fewer
# signups lost at the "check your inbox" step, at the cost of letting anyone
# hold an address they don't own. The verification email is still sent, so
# ADMIN_EMAILS (below) keeps working: promotion always requires a verified
# address, whatever this is set to.
#REQUIRE_EMAIL_VERIFICATION=false
#EMAIL_FROM="doop <no-reply@doop.example.com>"

# -------------------------------------------------------------- webhooks
# Outbound webhooks (Settings → Webhooks, docs/webhooks.md) refuse URLs on the
# server's own network — localhost, loopback, link-local, RFC 1918 — because the
# server connects to whatever a user types. A self-host whose n8n / Mattermost
# lives on the same Docker network can allow them:
#WEBHOOK_ALLOW_PRIVATE_URLS=true

# --------------------------------------------------------- resident agents
# Central server provider for resident tasks (board cards, @mentions):
# requesty (default, EU) only. Explicit azure/anthropic selection prevents boot;
# their legacy transports remain in source for isolated tests, not deployment.
# Private model accounts are removed.
# Eligible Creator/Admin accounts may explicitly select their Local Agent;
# an offline selected Local Agent pauses instead of falling back to the server.
#DOOP_AGENT_PROVIDER=requesty
# Requesty server key, kept only on the server. Missing/blank = server tier off;
# there is no automatic fallback to Anthropic or Azure credentials.
#REQUESTY_API_KEY=
# Operator-only endpoint, pinned to this verified EU URL; global/private URLs
# are rejected at boot. There is no user-facing URL setting.
#REQUESTY_CHAT_URL=https://router.eu.requesty.ai/v1/chat/completions
# Configure a monthly spend limit and alerts on this key IN REQUESTY. The task
# meter below counts tasks per account, not dollars or monthly spend. Requesty
# enforces its budget; HTTP errors stop the run without a provider switch.
# Every model in the policy's fallback chain must support tools and vision
# and run in the EU. See docs/prowin/requesty-server.md for checks and limits.
# Legacy Anthropic key — must remain unset; a nonempty value prevents boot.
# Distiller and background tagging use REQUESTY_API_KEY independently.
#ANTHROPIC_API_KEY=
# Dormant Azure transport settings; DOOP_AGENT_PROVIDER=azure prevents boot.
# These are not used by Requesty and never provide a fallback.
#AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_DEPLOYMENT=
# Dormant Azure API-version override.
#AZURE_OPENAI_API_VERSION=
# Dormant Azure reasoning-effort override.
#AZURE_OPENAI_REASONING_EFFORT=
# Server-agent allowance per account. Default 0 disables server-paid tasks.
# Only currently eligible Creator/Admin Local Agent execution bypasses it.
# MCP connections alone do not grant server-paid work.
#RESIDENT_TASK_LIMIT=0
# For the working-group test, set RESIDENT_TASK_LIMIT=1000 and a bounded
# Requesty key budget. 0 intentionally keeps server-paid resident work off.
# Model overrides for the resident team and the guideline distiller.
# Requesty agent default: the existing, smoke-tested layout policy.
# The dormant Anthropic transport retains its old model default in code.
#DOOP_AGENT_MODEL=policy/prowin-layout-gen
# Distiller always uses Requesty EU, independently of DOOP_AGENT_PROVIDER.
# Missing Requesty key = no summaries or proposals, even with an Anthropic key.
# Replace old Anthropic model overrides with an accessible Requesty policy.
#DOOP_DISTILL_MODEL=policy/prowin-text-gen
# Dormant background tagging uses DOOP_AGENT_MODEL through Requesty with vision
# and JSON-schema output. The background library remains disabled (TASK-12).
# --------------------------------------------------------- image generation
# Legacy image transports and their registry remain in source until the
# separate Magnific migration. Their keys below must stay unset: a nonempty
# value prevents server boot. Private model accounts are not supported.
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#ARK_API_KEY=
# Endpoint override for BytePlus ModelArk (default: the ap-southeast API).
#ARK_IMAGES_URL=
# The registry entry users start on before they pick (default gpt-image-2),
# and the text model that fronts OpenAI's hosted image tool (default: the
# gpt-5.6-terra).
#DOOP_IMAGE_MODEL=
#DOOP_IMAGE_ROUTER_MODEL=gpt-5.6-terra

# ---------------------------------------------------------------- meta ads
# The Meta integration (Integrations page): connect a Meta account with the
# ads_read permission and automations can pull ad creatives onto a canvas.
# Create an app at https://developers.facebook.com/apps (type: Business),
# add the "Facebook Login for Business" product, and register
# BETTER_AUTH_URL + /api/integrations/meta/callback as a valid OAuth redirect
# URI. Both must be set together; unset hides the Connect button.
#META_APP_ID=
#META_APP_SECRET=

# ------------------------------------------------------------ image search
# Stock photo search for design agents (the search_images tool, MCP and
# resident). Free key from https://www.pexels.com/api/ — unset disables photo
# search with a clear message to agents; icon search (search_icons) is keyless
# and always on.
#PEXELS_API_KEY=

# Optional upgrade for company-logo search (the search_logos tool). Keyless,
# search_logos serves open-source vector marks (well-known brands) plus
# DuckDuckGo favicons (any company, small raster). A free client id from
# https://developers.brandfetch.com/register upgrades results to high-res
# logos searchable by brand name.
#BRANDFETCH_CLIENT_ID=

# ----------------------------------------------------------- object storage
# Object storage for uploaded assets (the upload_asset MCP tool + browser
# paste/drop). Any S3-compatible store works; the names match what a Railway
# Bucket injects via variable references. Leave unset to store assets on
# local disk under ./data/assets (the development fallback).
#BUCKET=
#ACCESS_KEY_ID=
#SECRET_ACCESS_KEY=
#ENDPOINT=
#REGION=auto

# ----------------------------------------------------------------- billing
# Stripe, for paid shared workspaces (the Team plan: $20 per seat per month,
# or $192 per seat per year). Unset = billing is off and every workspace is
# active — the self-hosting default; nothing in the product is locked.
# With the key set, a workspace must hold a live subscription before it can
# grow (create canvases in it, invite people, take canvases in). Existing
# canvases stay open to their members whatever the subscription does.
#STRIPE_SECRET_KEY=
# The two per-seat prices. `node scripts/stripe-setup.mjs` creates them on
# your Stripe account and prints these lines.
#STRIPE_PRICE_TEAM_MONTHLY=
#STRIPE_PRICE_TEAM_YEARLY=
# Signing secret of a webhook endpoint at BETTER_AUTH_URL + /stripe/webhook
# subscribed to checkout.session.completed and customer.subscription.created /
# updated / deleted. Without it, changes made on Stripe's side (a cancelled
# card, a plan switched in the portal) never reach the workspace. Locally:
# `stripe listen --forward-to localhost:4400/stripe/webhook`.
#STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------- screenshots
# Frame screenshots render in a local Chrome/Chromium via puppeteer-core.
# Set only if it isn't auto-detected (the Docker image installs Chromium).
#CHROME_PATH=
# Set to 1 to pass --no-sandbox (needed in most containers; the Dockerfile does).
#CHROME_NO_SANDBOX=

# ------------------------------------------------------------- backgrounds
# The search_backgrounds library ships as a checked-in catalog
# (server/backgrounds.json) whose image bytes live in object storage under
# bg/ (put there by scripts/import-backgrounds.ts). An instance without those
# bytes can point here at one that has them, e.g. https://doop.design
#BACKGROUNDS_ORIGIN=

# ------------------------------------------------------------ rate limits
# Caps on the agent- and sync-facing endpoints, each a sliding 60-second
# window counted in one server process. Defaults suit the hosted service; a
# single-tenant self-host can raise them for bursty work. The counter each one
# keys on differs, so a cap is a budget for one key, not necessarily one person:
#   MCP_*      per connecting account (one agent key / OAuth user)
#   PREVIEW_*  per client IP for anonymous visitors (authenticated users are exempt)
# These are in-memory counters, so they reset on restart and do not aggregate
# across replicas — raise them only as far as one instance can absorb.
#MCP_UPLOADS_PER_MIN=15        # upload_asset ticket minting, per account (the byte PUT is not limited)
#MCP_SEARCHES_PER_MIN=12       # search_images / search_icons / search_logos / search_backgrounds, per account
#MCP_GENERATIONS_PER_MIN=6     # generate_image, per account (spends the payer's quota or money)
#PREVIEW_RENDERS_PER_MIN=12    # GET /i/ frame preview renders, per anonymous IP

# ------------------------------------------------------ endpoint overrides
# Upstream URLs the server talks to. The defaults are the public endpoints;
# override only to route through a proxy or point a test at a local stub.
#OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
#GEMINI_MODELS_URL=https://generativelanguage.googleapis.com/v1beta/models

# ------------------------------------------------------------- iOS push
# APNs key for the iOS app's Live Activities (agent status on the lock
# screen). Team id, the .p8 key's id and its contents (newlines may be
# written as \n). Unset = no pushes; the app still polls.
#DOOP_APNS_TEAM_ID=
#DOOP_APNS_KEY_ID=
#DOOP_APNS_PRIVATE_KEY=
#DOOP_APNS_BUNDLE_ID=design.doop.ios
