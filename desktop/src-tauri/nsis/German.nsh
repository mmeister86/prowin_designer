; Tauri-specific NSIS messages. Keep interpolation tokens and LangString IDs unchanged.
LangString addOrReinstall ${LANG_GERMAN} "Komponenten hinzufügen/neu installieren"
LangString alreadyInstalled ${LANG_GERMAN} "Bereits installiert"
LangString alreadyInstalledLong ${LANG_GERMAN} "${PRODUCTNAME} ${VERSION} ist bereits installiert. Wähle den gewünschten Vorgang aus und klicke auf Weiter."
LangString appRunning ${LANG_GERMAN} "{{product_name}} wird ausgeführt! Schließe die App und versuche es erneut."
LangString appRunningOkKill ${LANG_GERMAN} "{{product_name}} läuft! $\nKlicke auf OK, um die App zu beenden."
LangString chooseMaintenanceOption ${LANG_GERMAN} "Wähle die auszuführende Wartungsoption."
LangString chooseHowToInstall ${LANG_GERMAN} "Wähle, wie Du ${PRODUCTNAME} installieren möchtest."
LangString createDesktop ${LANG_GERMAN} "Desktop-Verknüpfung erstellen"
LangString dontUninstall ${LANG_GERMAN} "Nicht deinstallieren"
LangString dontUninstallDowngrade ${LANG_GERMAN} "Nicht deinstallieren (die Installation einer älteren Version ohne vorherige Deinstallation ist deaktiviert)"
LangString failedToKillApp ${LANG_GERMAN} "{{product_name}} konnte nicht beendet werden. Schließe die App und versuche es erneut."
LangString installingWebview2 ${LANG_GERMAN} "WebView2 wird installiert …"
LangString newerVersionInstalled ${LANG_GERMAN} "Eine neuere Version von ${PRODUCTNAME} ist bereits installiert! Die Installation einer älteren Version wird nicht empfohlen. Wenn Du diese ältere Version installieren möchtest, deinstalliere am besten zuerst die aktuelle Version. Wähle den gewünschten Vorgang aus und klicke auf Weiter."
LangString older ${LANG_GERMAN} "älter"
LangString olderOrUnknownVersionInstalled ${LANG_GERMAN} "Eine Version von ${PRODUCTNAME} ist auf Deinem System installiert ($R4). Es wird empfohlen, sie vor der Installation zu deinstallieren. Wähle den gewünschten Vorgang aus und klicke auf Weiter."
LangString silentDowngrades ${LANG_GERMAN} "Die Installation älterer Versionen ist für dieses Installationsprogramm deaktiviert. Du kannst die unbeaufsichtigte Installation nicht fortsetzen. Verwende das Installationsprogramm mit grafischer Oberfläche.$\n"
LangString unableToUninstall ${LANG_GERMAN} "Die Deinstallation ist fehlgeschlagen!"
LangString uninstallApp ${LANG_GERMAN} "${PRODUCTNAME} deinstallieren"
LangString uninstallBeforeInstalling ${LANG_GERMAN} "Vor der Installation deinstallieren"
LangString unknown ${LANG_GERMAN} "unbekannt"
LangString webview2AbortError ${LANG_GERMAN} "Die Installation von WebView2 ist fehlgeschlagen! Die App benötigt WebView2. Versuche, das Installationsprogramm neu zu starten."
LangString webview2DownloadError ${LANG_GERMAN} "Fehler beim Herunterladen von WebView2: $0"
LangString webview2DownloadSuccess ${LANG_GERMAN} "WebView2-Bootstrapper erfolgreich heruntergeladen"
LangString webview2Downloading ${LANG_GERMAN} "WebView2-Bootstrapper wird heruntergeladen …"
LangString webview2InstallError ${LANG_GERMAN} "Die Installation von WebView2 ist mit dem Exit-Code $1 fehlgeschlagen."
LangString webview2InstallSuccess ${LANG_GERMAN} "WebView2 erfolgreich installiert"
LangString deleteAppData ${LANG_GERMAN} "Anwendungsdaten löschen"
